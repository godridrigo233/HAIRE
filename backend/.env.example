# ==========================================================================
# Configuración del backend Haire — este es el .env real para local y/o
# como referencia para pegar en Render → Environment Variables.
# NUNCA subir este archivo a git (ya está en .gitignore).
# ==========================================================================

# --- Base de datos (Postgres de Supabase, vía pooler transaction-mode) ---
# Reemplaza TU_PASSWORD_REAL por el password real de tu base de datos
# (Supabase > Project Settings > Database > Reset database password si no lo tienes).
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<database-password>@<pooler-host>:6543/postgres?pgbouncer=true

# --- Supabase Storage (para subir los PDFs al bucket privado `cv`) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<supabase-service-role-key>
SUPABASE_BUCKET=cv

# --- Groq (IA) ---
# PENDIENTE: pega aquí la key NUEVA que generaste en console.groq.com
# (la anterior quedó expuesta en el chat y no debe reutilizarse)
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=qwen/qwen3.8-27b

# --- JWT (auth) ---
# PENDIENTE: pega aquí el secreto NUEVO generado con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<random-secret-at-least-32-characters>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# --- Auth interina (la tabla `usuarios` no tiene columna de password) ---
# Password compartida de demo. El login valida que el correo exista en `usuarios`
# y que la password coincida con esta.
AUTH_DEMO_PASSWORD=<demo-password>

# --- CORS: orígenes del frontend permitidos (separados por coma) ---
# En local, deja esto así. En Render, cámbialo a tu dominio de Vercel en el Paso 4.
CORS_ORIGINS=https://haire-tau.vercel.app